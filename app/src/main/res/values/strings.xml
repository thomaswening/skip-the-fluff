<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Skip the Fluff</string>
    <!-- Shown when a page outside Duolingo should open in the browser, but the phone has none (REQ-015).
         Android cuts a toast off after two lines, so this must stay short. -->
    <string name="no_browser">No browser can open this page. Install one, or switch one on, and try again.</string>
    <!-- Shown once per start of the app when Android will not ask for the microphone again (REQ-049).
         The button opens the app's page in Android's settings, where Permissions leads to the microphone. -->
    <string name="microphone_off">The microphone is off for Skip the Fluff. To speak in exercises, switch it on under Permissions.</string>
    <string name="microphone_off_settings">Settings</string>
    <!-- Shown when the website's page process was lost three times in a row, each within a minute of loading
         (ADR-0003, point 4). The app then stops reloading until the learner returns to it. Must stay short. -->
    <string name="website_not_loaded">The website could not be loaded. Leave the app and return to try again.</string>
    <!-- The screen shown when a page of the website cannot be loaded (REQ-044). The text names what the learner
         can check. The button names what it does: it loads the page that failed, once per tap. -->
    <string name="no_connection_title">Duolingo cannot be reached</string>
    <string name="no_connection_text">Check that Wi-Fi or mobile data is on, then reload the page. If the phone is online, Duolingo itself may be down: reload again in a few minutes.</string>
    <string name="no_connection_reload">Reload page</string>
</resources>
